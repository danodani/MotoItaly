---
// ============================================================
// Layout.astro — scheletro condiviso di tutte le pagine Astro
// ------------------------------------------------------------
// Props SEO dinamiche (title, description, url, og:title):
//   <Layout title="..." description="..." >
// Lo slot principale inietta il <main> della pagina;
// lo slot name="head" inietta script extra in <head> (es. JSON-LD).
// ============================================================
interface Props {
    title: string;
    description: string;
    ogTitle?: string;
    canonicalUrl?: string;
    showDisclaimer?: boolean;
}

const { title, description, ogTitle, canonicalUrl, showDisclaimer = false } = Astro.props;

const SITE_URL = 'https://motoitaly.pages.dev';
const pageTitle = title;
const og = ogTitle || title;
const url = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
---

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{pageTitle}</title>

    <!-- SEO / Open Graph -->
    <link rel="canonical" href={url}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={og}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={url}>
    <meta property="og:site_name" content="Moto Italy">
    <meta name="twitter:card" content="summary">

    <!-- Slot per script di pagina (es. JSON-LD FAQPage) -->
    <slot name="head" />

    <script>
        (function() {
            const saved = localStorage.getItem('theme');
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = saved === 'dark' || saved === 'light' ? saved : (systemDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter-v20-latin-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="logo">
                <img src="/img/logo.png" alt="Moto Italy" class="logo-img">
                <span class="logo-text">Moto Italy</span>
            </a>

            <div class="header-actions">
                <!-- Ricerca desktop: lente che si espande in input -->
                <div class="search-container search-container-desktop" id="searchDesktop">
                    <button class="search-toggle-btn" id="searchToggle" aria-label="Cerca nel sito" title="Cerca">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                    <input type="text" class="search-input search-input-desktop" placeholder="Cerca guide e articoli..." aria-label="Cerca guide e articoli" autocomplete="off">
                    <div class="search-results-dropdown" role="listbox"></div>
                </div>

                <button class="theme-toggle" id="themeToggle" aria-label="Cambia tema" title="Cambia tema">
                    <span class="theme-icon theme-icon-light" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l-1.42-1.42M18.36 5.64l1.42-1.42"></path>
                        </svg>
                    </span>
                    <span class="theme-icon theme-icon-dark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                    </span>
                </button>

                <button class="menu-toggle" id="menuToggle" aria-label="Apri menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <nav class="main-nav" id="mainNav">
                <ul>
                    <li><a href="/wiki">Wiki &amp; Guide</a></li>
                    <li><a href="/faq.html">FAQ</a></li>
                    <li><a href="/strumenti.html">Strumenti Utili</a></li>
                    <li><a href="/bar">Il Bar del Motociclista</a></li>
                </ul>
                <!-- Ricerca mobile: campo visibile in fondo al menu hamburger -->
                <div class="search-container search-mobile" id="searchMobile">
                    <input type="text" class="search-input" placeholder="Cerca guide e articoli..." aria-label="Cerca guide e articoli" autocomplete="off">
                    <div class="search-results-dropdown" role="listbox"></div>
                </div>
            </nav>
        </div>
    </header>

    <slot />

    <footer class="site-footer">
        <div class="container footer-inner">
            <nav class="footer-nav" aria-label="Link secondari">
                <a href="/chi-sono.html">Chi sono</a>
                <a href="/contatti.html">Contattaci</a>
            </nav>
            <p>&copy; 2026 Moto Italy. Tutti i diritti riservati.</p>
            {showDisclaimer && (
                <p class="footer-disclaimer">
                    <strong>Trasparenza:</strong> Alcuni link in questa pagina possono essere link di affiliazione.
                    Se acquisti tramite essi, potremmo ricevere una piccola commissione senza costi aggiuntivi per te.
                    Questo ci aiuta a mantenere il sito attivo e gratuito.
                </p>
            )}
        </div>
    </footer>

    <script src="/js/script.js" defer></script>

    <script>
        // ===== Ricerca client-side (desktop + mobile) =====
        // Indice caricato una sola volta (/search.json generato al build)
        let searchIndexPromise = null;
        const ensureIndex = () => {
            if (!searchIndexPromise) {
                searchIndexPromise = fetch('/search.json')
                    .then((r) => r.json())
                    .catch(() => {
                        searchIndexPromise = null; // permette il retry al focus successivo
                        return [];
                    });
            }
            return searchIndexPromise;
        };

        function renderResults(container, query) {
            const dropdown = container.querySelector('.search-results-dropdown');
            if (!dropdown) return;
            const q = query.trim().toLowerCase();
            if (q.length < 2) {
                dropdown.classList.remove('open');
                dropdown.innerHTML = '';
                return;
            }
            ensureIndex().then((items) => {
                const matches = items
                    .filter((it) =>
                        (it.title || '').toLowerCase().includes(q) ||
                        (it.excerpt || '').toLowerCase().includes(q))
                    .slice(0, 8);
                dropdown.innerHTML = '';
                if (!matches.length) {
                    const empty = document.createElement('div');
                    empty.className = 'search-result-empty';
                    empty.textContent = `Nessun risultato per "${query.trim()}"`;
                    dropdown.appendChild(empty);
                } else {
                    matches.forEach((it) => {
                        const a = document.createElement('a');
                        a.href = it.url;
                        a.className = 'search-result-item';
                        const t = document.createElement('span');
                        t.className = 'search-result-title';
                        t.textContent = it.title;
                        const b = document.createElement('span');
                        b.className = 'search-result-badge';
                        b.textContent = it.collection === 'wiki' ? 'Wiki' : 'Bar';
                        a.appendChild(t);
                        a.appendChild(b);
                        if (it.excerpt) {
                            const x = document.createElement('span');
                            x.className = 'search-result-excerpt';
                            x.textContent = it.excerpt + '…';
                            a.appendChild(x);
                        }
                        dropdown.appendChild(a);
                    });
                }
                dropdown.classList.add('open');
            });
        }

        document.querySelectorAll('.search-container').forEach((container) => {
            const input = container.querySelector('.search-input');
            if (!input) return;
            input.addEventListener('focus', ensureIndex); // prefetch al primo focus
            input.addEventListener('input', () => renderResults(container, input.value));
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    input.value = '';
                    renderResults(container, '');
                    input.blur();
                }
                if (e.key === 'Enter') {
                    const first = container.querySelector('.search-result-item');
                    if (first) window.location.href = first.getAttribute('href');
                }
            });
        });

        // Toggle desktop: la lente si espande in input; click fuori = chiudi e svuota
        const searchDesktop = document.getElementById('searchDesktop');
        const searchToggle = document.getElementById('searchToggle');
        const searchDesktopInput = searchDesktop?.querySelector('.search-input');
        if (searchDesktop && searchToggle && searchDesktopInput) {
            searchToggle.addEventListener('click', () => {
                const open = searchDesktop.classList.toggle('search-open');
                if (open) {
                    ensureIndex();
                    searchDesktopInput.focus();
                } else {
                    searchDesktopInput.value = '';
                    renderResults(searchDesktop, '');
                }
            });
            document.addEventListener('click', (e) => {
                if (!searchDesktop.contains(e.target)) {
                    searchDesktop.classList.remove('search-open');
                    searchDesktopInput.value = '';
                    renderResults(searchDesktop, '');
                }
            });
        }
    </script>
</body>
</html>
