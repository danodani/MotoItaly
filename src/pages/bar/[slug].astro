---
// ============================================================
// src/pages/bar/[slug].astro — pagine statiche del blog
// ------------------------------------------------------------
// getStaticPaths() trasforma ogni Markdown di src/content/bar/
// in una pagina HTML fisica (/bar/<slug>.html) durante il build.
// Sostituisce il vecchio articolo.html?file=... (eliminato).
// ============================================================
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const posts = await getCollection('bar', ({ data }) => Boolean(data.title));

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, date, author, excerpt, featured_image } = post.data;
const dateStr = date.toLocaleDateString('it-IT', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});
const description = excerpt || `${title} — dal Bar del Motociclista di Moto Italy.`;
---

<Layout
    title={`${title} - Il Bar del Motociclista - Moto Italy`}
    description={description}
    showDisclaimer={true}
>
    <main class="page-content">
        <div class="container article-container">
            <nav class="breadcrumb">
                <a href="/">Home</a> <span>/</span> <a href="/bar">Il Bar del Motociclista</a> <span>/</span> <span>{title}</span>
            </nav>
            <article>
                <h1 class="page-title">{title}</h1>
                <p class="article-meta">
                    {dateStr}
                    {author && <> · {author}</>}
                </p>
                {featured_image && (
                    <img src={featured_image} alt={title} class="article-featured-image" />
                )}
                <div class="article-body">
                    <Content />
                </div>
            </article>
        </div>
    </main>
</Layout>
